[Unit]
Description=VPS Panel privileged agent
After=network-online.target mariadb.service
# Wants, not Requires: with Requires every MariaDB restart (unattended
# upgrades) restarted the agent and killed its running tasks, and a MariaDB
# that failed to start took the whole panel down with it.
Wants=network-online.target mariadb.service

[Service]
Type=simple
EnvironmentFile=/etc/vps-panel/.env
ExecStart=/usr/local/bin/vps-panel-agent serve
Restart=on-failure
RestartSec=2s
LimitNOFILE=65536
# UMask 0007 so files the agent creates in /var/lib/vps-panel (panel.db, -wal,
# -shm) are group-writable. Combined with the setgid bit on that directory
# (install.sh chmod g+s), new files inherit group=vps-panel and the panel
# (running as vps-panel) can write them too.
UMask=0007
StandardOutput=journal
StandardError=journal
NoNewPrivileges=false

# ProtectHome= used to be `read-only` here, but the agent legitimately needs
# write access to BOTH /home (for `useradd -m`, `userdel -r`, SSH key writes
# under /home/<user>/.ssh/) and /root (for `git pull` / `cargo build` from
# the self-update endpoint). ReadWritePaths= and BindPaths= can in theory
# "punch holes" through ProtectHome=, and that works reliably for
# subdirectories of /root, but in practice systemd re-applies ProtectHome's
# read-only flag AFTER BindPaths= for top-level /home, leaving it read-only
# in the agent's namespace despite BindPaths=/home being present. Rather
# than fight the systemd ordering, we drop ProtectHome entirely. The agent
# runs as root with no privilege restrictions and a bearer-token-gated unix
# socket — ProtectHome was security theatre, not real defense in depth.
# ProtectHome=read-only
# Self-update endpoints (POST /system/self-update + GET /system/update-check)
# still rely on these paths existing; the `-` prefix marks each as optional
# (no error if absent on a fresh box where /root/.cargo doesn't exist yet).
# We keep the ReadWritePaths= list as a documentation aid even though,
# without ProtectHome=, the kernel doesn't restrict access to /root.
#
# If you cloned the repo somewhere other than /root/vps-panel-src, add a
# drop-in at /etc/systemd/system/vps-panel-agent.service.d/repo-paths.conf
# with `ReadWritePaths=-/your/path -/your/cargo` and `systemctl daemon-reload`.
ReadWritePaths=-/root/vps-panel-src -/root/.cargo -/root/.ssh -/root/.npm
RuntimeDirectory=vps-panel
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
